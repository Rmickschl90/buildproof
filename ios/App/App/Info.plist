<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Leeward</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Added 2026-08-06, iOS half of the native checkout fix (see
	     lib/capacitorCheckout.ts and android/app/src/main/AndroidManifest.xml's
	     matching comment for the full explanation). Registers this app's own
	     custom URL scheme so iOS hands com.linquelabs.leeward:// links back to
	     this already-running app instead of leaving it stranded after Stripe
	     checkout/the billing portal finishes in the in-app browser
	     (@capacitor/browser's SFSafariViewController on iOS). AppDelegate.swift
	     already has the Capacitor-generated application(_:open:options:) method
	     that forwards this to the App plugin: no changes needed there.
	     Deliberately the same scheme string as Android's, since
	     app/checkout-return/page.tsx uses one shared constant for both
	     platforms: it does not need to match this app's bundle identifier
	     (com.linquelabs.leewardapp), it just needs to be a unique string this
	     app registers and the web code and native manifests agree on. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.linquelabs.leewardapp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.linquelabs.leeward</string>
			</array>
		</dict>
	</array>
	<!-- Added 2026-08-13: without these purpose strings, iOS crashes the app
	     outright the moment it tries to invoke the camera or photo library
	     (no permission prompt shown, no graceful denial: an immediate
	     termination). This is almost certainly why "Take Photo" crashed
	     repeatedly on a fresh TestFlight install of build 11 while
	     attempting to attach a photo to an entry, and very likely why
	     Apple's review was rejected under Guideline 2.1 (Performance: App
	     Completeness) rather than a purely informational request: Apple's
	     own rejection message separately flags Guideline 5.1.1 (missing
	     purpose strings) as a common cause. Camera capture itself uses a
	     plain HTML file input (accept="image/*" capture="environment"),
	     which still requires these native iOS purpose strings to be
	     present even though no native Capacitor camera plugin is used. -->
	<key>NSCameraUsageDescription</key>
	<string>Leeward needs camera access so you can take and attach photos to your project entries and approvals in the field.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Leeward needs access to your photo library so you can attach existing photos to your project entries and approvals.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
